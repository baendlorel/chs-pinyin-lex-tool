{
  "type": "module",
  "scripts": {
    "upkt": "pnpm up -L kt.js @ktjs/mui @ktjs/mui-icon @ktjs/ts-plugin @ktjs/vite-plugin-ktjsx",
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "node dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "oxlint": "^1.64.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@ktjs/mui": "^0.40.23",
    "@ktjs/mui-icon": "^0.40.1",
    "@ktjs/ts-plugin": "^0.3.7",
    "@ktjs/vite-plugin-ktjsx": "^0.5.4",
    "@types/node": "^25.7.0",
    "fastify": "^5.8.5",
    "kt.js": "^0.40.23"
  }
}